{
  "name": "eduardo-lopez",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bun --bun next dev --hostname 0.0.0.0 --port 3000",
    "build": "bun run generate:resume && bun --bun next build",
    "start": "bun --bun next start --hostname 0.0.0.0 --port 3000",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit --coverage",
    "test:e2e": "playwright test",
    "generate:resume": "bun scripts/generate-resumes.ts",
    "check:content": "bun scripts/check-content.ts",
    "check:react": "react-doctor . --yes --verbose --blocking warning",
    "check": "bun run lint && bun run typecheck && bun run test && bun run check:content"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "bun": "1.4.2",
    "eslint": "9",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "react-doctor": "^0.9.14",
    "sharp": "^0.35.5",
    "tailwindcss": "3",
    "typescript": "6"
  },
  "trustedDependencies": [
    "bun",
    "unrs-resolver"
  ]
}
